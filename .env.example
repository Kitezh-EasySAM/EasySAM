PORT=8000
DB_PATH=sam.db
# общий токен агентов (X-Ingest-Token) — только для разработки и --fake; пусто = выключен, агенты подключаются ключом
# регистрации из «Рабочие места» → «Установка агента» и получают собственный токен ПК
INGEST_TOKEN=
# Вход в интерфейс по логину и паролю. Первый пользователь — admin: пароль из ADMIN_PASSWORD,
# пусто — «admin». Пароль первого входа временный: система попросит сменить его. Ещё пользователи: make user LOGIN=ivanov ROLE=viewer
ADMIN_PASSWORD=
SESSION_HOURS=12
# 1 — cookie только по HTTPS (за nginx с TLS); TRUST_PROXY=1 — брать IP клиента из X-Forwarded-For
COOKIE_SECURE=
TRUST_PROXY=
# AUTH=off — без входа (только локальная отладка!)
AUTH=
# токен для скриптов (Authorization: Bearer …, права admin); пусто = выключен
ADMIN_TOKEN=
# фронт на другом адресе (не через прокси): CORS_ORIGIN=http://host:5173
CORS_ORIGIN=
# 1 — агенты только с токеном своего ПК (рекомендуется в боевой сети)
REQUIRE_DEVICE_TOKEN=
# ИИ: пусто = выключен (ассистент работает на правилах). LM Studio: OPENAI_BASE_URL=http://localhost:1234/v1, LLM_MODEL=qwen/qwen3.5-9b
# LLM_TIMEOUT_MS=120000 · LLM_MAX_CONCURRENT=2 · SQL_TIMEOUT_MS=5000 · EULA_FETCH=off — не скачивать страницы лицензий из интернета
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# адрес сервера, который видят ПК (подставляется в sam-agent.json из «Подключить агента»), например http://192.168.249.1:8000
PUBLIC_URL=
# Docker задаёт сам: собранный фронт на «/» (пусто — только API, фронт через make web)
# WEB_DIST=../web/dist
# файлы агента на «/downloads/» (только *.exe и *.ps1); по умолчанию ../agent/dist/sam-agent (make agent-dist)
# AGENT_DIST=../agent/dist/sam-agent
